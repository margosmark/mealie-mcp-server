# Copy to .env for local runs, or pass these to Docker with -e.
# Never commit a real .env — it contains your API key.

# Base URL of your Mealie instance (no trailing slash needed)
MEALIE_URL=https://mealie.example.com

# Mealie API key: user menu -> Manage Your Data -> API Tokens -> create
MEALIE_API_KEY=replace-with-your-api-token
